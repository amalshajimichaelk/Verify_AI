# ==============================================================================
# VerifyAI - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Execution Mode
# ------------------------------------------------------------------------------
# Set to 'true' to run entirely in memory with mock data (default for dev without services)
DEMO_MODE=true
# Set to 'true' to enable the real Gemini AI model for forensic analysis
ENABLE_REAL_ANALYSIS=false

# ------------------------------------------------------------------------------
# Authentication (NextAuth.js v5)
# ------------------------------------------------------------------------------
# Generate with: `npx auth secret` or `openssl rand -base64 33`
AUTH_SECRET=your_auth_secret_here
# Optional: Set for custom URL in non-Vercel deployments
# AUTH_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Database (Neon PostgreSQL Serverless)
# ------------------------------------------------------------------------------
# Required if DEMO_MODE is false
# Format: postgres://[user]:[password]@[host]/[dbname]?sslmode=require
DATABASE_URL="postgres://dummy:dummy@localhost:5432/verifyai?sslmode=disable"
# Only needed for Drizzle migrations/studio if different from main URL
# DIRECT_URL=

# ------------------------------------------------------------------------------
# Media Storage (Vercel Blob)
# ------------------------------------------------------------------------------
# Required for real media uploads
BLOB_READ_WRITE_TOKEN=

# ------------------------------------------------------------------------------
# AI Provider (Google Gemini)
# ------------------------------------------------------------------------------
# Required if ENABLE_REAL_ANALYSIS=true
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# Async Job Queue (Inngest)
# ------------------------------------------------------------------------------
# Required for real async processing pipeline
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ------------------------------------------------------------------------------
# Rate Limiting & Edge caching (Upstash Redis)
# ------------------------------------------------------------------------------
# Required for API rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
